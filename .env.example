# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=Your Name - Portfolio

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Email (Optional - for contact form notifications)
# Resend delivers a notification for every stored inquiry. Without it the message
# is still saved to the admin dashboard; only the inbox alert is skipped.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_NOTIFICATION_EMAIL=your_email@example.com
CONTACT_FROM_EMAIL=Portfolio <hello@your-domain.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
CONTACT_EMAIL=your_email@example.com

# reCAPTCHA (Optional - for contact form spam protection)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key